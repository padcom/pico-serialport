// A serial port (Linux first): opened exclusively, configured raw with the options' speed and
// framing, read and written asynchronously through the runtime's I/O threads (std/process
// `Reader`/`Writer` on the port's descriptors). It's a `ByteStream`.
import * as t from "c:termios.h"
import * as f from "c:fcntl.h"
import { Reader, Writer } from "std/process"
import { CFLAG_OFFSET, O_CLOEXEC, TERMIOS_BYTES, addr, close as closeFd, describe, dup, errno, fcntl, ioctl, setU32At,
  speedConstant, tcflush, tcgetattr, tcsetattr, u32At, cfmakeraw, cfsetspeed, open as openFd } from "./posix"
import { ByteStream } from "./stream"

export enum Parity { None, Even, Odd }

export enum FlowControl { None, Hardware }

export struct SerialOptions {
  baudRate: int
  /// 5, 6, 7 or 8 (default 8).
  dataBits?: int
  parity?: Parity
  /// 1 or 2 (default 1).
  stopBits?: int
  flowControl?: FlowControl
}

/// Why a port couldn't be opened or used. `code`: NOT_FOUND, PERMISSION_DENIED, BUSY,
/// NOT_A_SERIAL_PORT, UNSUPPORTED (an option this port or platform can't do), CLOSED or IO.
export class SerialError extends Error {
  public code: string
  public errno: int

  constructor(code: string, message: string, errno: int = 0) {
    super(message)
    this.code = code
    this.errno = errno
  }
}

/// The ioctl that makes a tty exclusive: further opens fail with EBUSY (Linux).
const TIOCEXCL: int = 0x540C
/// Undoes TIOCEXCL. Closing clears it on a real port, but not on a tty that outlives its last close (a pty slave).
const TIOCNXCL: int = 0x540D

function failure(path: string, what: string): SerialError {
  const e = errno()
  const code = match (e) {
    2 => "NOT_FOUND",
    13 => "PERMISSION_DENIED",
    1 => "PERMISSION_DENIED",
    16 => "BUSY",
    25 => "NOT_A_SERIAL_PORT",
    _ => "IO",
  }
  new SerialError(code, `${path}: ${what}: ${describe(e)}`, e)
}

function check(cond: bool, message: string): void throws SerialError {
  if (!cond) {
    throw new SerialError("UNSUPPORTED", message)
  }
}

/// The `c_cflag` bits for the options' framing and flow control, over `cflag`.
export function framing(cflag: int, options: SerialOptions): int throws SerialError {
  const dataBits = options.dataBits ?? 8
  const stopBits = options.stopBits ?? 1
  check(dataBits >= 5 && dataBits <= 8, `dataBits ${dataBits}: use 5 to 8`)
  check(stopBits == 1 || stopBits == 2, `stopBits ${stopBits}: use 1 or 2`)
  const size = match (dataBits) {
    5 => t.CS5 as int,
    6 => t.CS6 as int,
    7 => t.CS7 as int,
    _ => t.CS8 as int,
  }
  let c = (cflag & ~(t.CSIZE as int) & ~(t.PARENB as int) & ~(t.PARODD as int) & ~(t.CSTOPB as int)
      & ~(t.CRTSCTS as int)) | size | (t.CREAD as int) | (t.CLOCAL as int)
  match (options.parity ?? Parity.None) {
    Even => {
      c = c | (t.PARENB as int)
    },
    Odd => {
      c = c | (t.PARENB as int) | (t.PARODD as int)
    },
    None => {},
  }
  if (stopBits == 2) {
    c = c | (t.CSTOPB as int)
  }
  if ((options.flowControl ?? FlowControl.None) == FlowControl.Hardware) {
    c = c | (t.CRTSCTS as int)
  }
  c
}

/// Raw mode, the speed and the framing on `fd`.
function configure(fd: c_int, path: string, options: SerialOptions): void throws SerialError {
  const speed = speedConstant(options.baudRate)
  check(speed >= 0, `baudRate ${options.baudRate} isn't a standard rate`)
  const tio = new Uint8Array(TERMIOS_BYTES)
  if (tcgetattr(fd, addr(tio)) != 0) {
    throw failure(path, "reading its settings")
  }
  cfmakeraw(addr(tio))
  if (cfsetspeed(addr(tio), speed as u32) != 0) {
    throw failure(path, `setting ${options.baudRate} baud`)
  }
  setU32At(tio, CFLAG_OFFSET, framing(u32At(tio, CFLAG_OFFSET), options))
  if (tcsetattr(fd, t.TCSANOW, addr(tio)) != 0) {
    throw failure(path, "applying its settings")
  }
}

export class SerialPort implements ByteStream {
  public readonly path: string
  public readonly options: SerialOptions
  readFd: int
  reader: Reader
  writer: Writer
  closed: bool = false

  constructor(path: string, options: SerialOptions, fd: int) {
    this.path = path
    this.options = options
    this.readFd = fd
    // Two descriptors: the reader and the writer each close their own.
    const w = dup(fd as c_int) as int
    this.reader = new Reader(fd, path, true)
    this.writer = new Writer(w, path, true)
  }

  /// The next bytes received, as soon as some are there; null once the port is gone.
  public async read(): Promise<Uint8Array?> throws Error {
    if (closed) {
      throw new SerialError("CLOSED", `${path} is closed`)
    }
    await reader.read()
  }

  /// Sends all of `bytes`.
  public async write(bytes: Uint8Array): Promise<void> throws Error {
    if (closed) {
      throw new SerialError("CLOSED", `${path} is closed`)
    }
    await writer.write(bytes)
  }

  /// Drops what was received but not read yet, and what was written but not sent yet.
  public flush(): void {
    if (!closed) {
      tcflush(readFd as c_int, t.TCIOFLUSH)
    }
  }

  /// Closes the port. A `read()` already waiting isn't interrupted, and keeps the program from
  /// ending (pico-lang #100): close after the last read, or end with `exit()`.
  public close(): void {
    if (closed) {
      return
    }
    closed = true
    ioctl(readFd as c_int, TIOCNXCL as c_ulong)
    writer.close()
    closeFd(readFd as c_int)
  }

  /// `for await (const chunk of port)`.
  public asyncIterator(): Reader {
    reader
  }
}

/// Opens `path` exclusively with `options`.
export function openPort(path: string, options: SerialOptions): SerialPort throws SerialError {
  // Non-blocking while opening (a modem line without carrier would block), blocking afterwards.
  const fd = openFd(path, f.O_RDWR | f.O_NOCTTY | f.O_NONBLOCK | (O_CLOEXEC as c_int))
  if (fd < 0) {
    throw failure(path, "opening it")
  }
  if (ioctl(fd, TIOCEXCL as c_ulong) != 0) {
    const e = failure(path, "making it exclusive")
    closeFd(fd)
    throw e
  }
  try {
    configure(fd, path, options)
  } catch (e: SerialError) {
    ioctl(fd, TIOCNXCL as c_ulong)
    closeFd(fd)
    throw e
  }
  fcntl(fd, f.F_SETFL, f.O_RDWR)
  new SerialPort(path, options, fd as int)
}
