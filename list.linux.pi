// The serial ports this machine has, from sysfs (Linux).
import { attribute, classDevices, usbDeviceOf } from "padcom/pico-linux-sysfs"
import { PortInfo } from "./types"

export { PortInfo } from "./types"

/// The serial ports, in name order. A tty counts when it has a device behind it and isn't an 8250
/// placeholder (`type` 0, PORT_UNKNOWN). `sysfs` is for tests.
export async function listPorts(sysfs: string = "/sys", dev: string = "/dev"): Promise<PortInfo[]> {
  const ports: PortInfo[] = []
  for (const tty of await classDevices("tty", sysfs)) {
    const device = tty.device
    if (device == null || (await attribute(`${tty.path}/type`)) == "0") {
      continue
    }
    const info: PortInfo = { path: `${dev}/${tty.name}` }
    const usb = await usbDeviceOf(device, sysfs)
    if (usb != null) {
      info.vendorId = usb.vendorId
      info.productId = usb.productId
      info.serialNumber = usb.serialNumber
      info.manufacturer = usb.manufacturer
      info.product = usb.product
    }
    ports.push(info)
  }
  return ports
}
